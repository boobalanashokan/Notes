{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MLOps Curriculum Roadmap",
  "description": "Structured roadmap data for a learning track, with support for multiple tracks and nested areas/topics.",
  "type": "object",
  "required": ["tracks"],
  "properties": {
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/track"
      }
    }
  },
  "definitions": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Lowercase slug identifier suitable for stable references."
    },
    "track": {
      "type": "object",
      "required": ["id", "name", "areas"],
      "properties": {
        "id": {
          "$ref": "#/definitions/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/area"
          }
        }
      },
      "additionalProperties": false
    },
    "area": {
      "type": "object",
      "required": ["id", "name", "topics"],
      "properties": {
        "id": {
          "$ref": "#/definitions/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/topic"
          }
        }
      },
      "additionalProperties": false
    },
    "topic": {
      "type": "object",
      "required": [
        "id",
        "name",
        "week",
        "type",
        "subtopics",
        "learning_outcome",
        "project_task",
        "depends_on",
        "done"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "week": {
          "type": "number",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "subtopics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "learning_outcome": {
          "type": "string",
          "minLength": 1
        },
        "project_task": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/slug"
          }
        },
        "done": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
